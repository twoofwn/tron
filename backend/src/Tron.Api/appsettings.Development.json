{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "ConnectionStrings": {
    "Tron": "Server=localhost;Database=TronDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Storage": {
    "MediaRoot": "../../.data/media_dev"
  },
  "Database": {
    "AutoInitializeFromSql": true,
    "SqlScriptPath": "../../trondb.sql"
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
