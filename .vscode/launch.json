{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter (Tự động chọn thiết bị)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--no-web-resources-cdn"
            ]
        },
        {
            "name": "Flutter (Chrome Web)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--no-web-resources-cdn"
            ]
        },
        {
            "name": "Flutter (Windows Desktop)",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows"
        },
        {
            "name": "Flutter (Release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--no-web-resources-cdn"
            ]
        },
        {
            "name": "Backend .NET API (Tron.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/backend/src/Tron.Api/bin/Debug/net9.0/Tron.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/src/Tron.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openUrl",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}
